# Salin ke .env lalu isi. Jangan commit .env.

# WAJIB. Acak, minimal 32 karakter. Buat dengan: openssl rand -hex 32
SESSION_SECRET=

# Admin pertama, dibuat sekali saat start bila belum ada admin.
# Username 3-24 karakter (huruf, angka, titik, garis bawah). Password minimal 8 karakter.
ADMIN_USER=
ADMIN_PASS=

# Port di STB.
HOST_PORT=3000

# Isi 1 bila di depan Koga ada reverse proxy HTTPS (Nginx Proxy Manager, Caddy, Cloudflare Tunnel).
# Cookie sesi jadi "secure" otomatis bila koneksi HTTPS.
TRUST_PROXY=

# Hanya bila proxy mengubah header Host. Daftar origin dipisah koma, contoh: https://koga.contoh.id
ALLOWED_ORIGINS=

# Opsional: batas percobaan. Login hanya menghitung percobaan gagal (per 15 menit), register per jam.
# RATE_LOGIN_MAX=10
# RATE_REGISTER_MAX=5

# Tahap 3. Alamat publik Koga (origin saja, tanpa path). Wajib untuk QR.
# Gunakan HTTPS untuk mikrofon/kamera; localhost boleh untuk tes.
BASE_URL=https://koga.contoh.id
STUN_URL=stun:stun.l.google.com:19302
# Opsional, isi keduanya untuk TURN. Buat TURN_SECRET dengan openssl rand -hex 32.
TURN_URL=
TURN_SECRET=
# Untuk profile turn di Linux, isi public IP atau publicIP/privateIP bila di belakang NAT.
TURN_EXTERNAL_IP=
